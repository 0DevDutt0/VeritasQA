# --- Local environment (not part of the project) ---
/VeritasQA/
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Tooling ---
.playwright-mcp/
.vscode/
.idea/

# --- Source documents and generated data (never committed) ---
# Source PDFs are never committed: the user's document may be confidential or copyrighted.
*.pdf
*.db
*.sqlite
*.sqlite3
data/documents/*
!data/documents/.gitkeep
data/extracted/*
!data/extracted/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/evaluations/runs/
# data/evaluations/gold/ is deliberately NOT ignored: hand-made gold annotations cannot be regenerated.

# --- Model artifacts, weights, caches and local secrets (P0-ENV) ---
# Downloaded model files and local caches live under models/ and are never committed.
# Tracked there: models/README.md and the JSON manifests (repo, revision, licence, SHA-256).
models/**
!models/README.md
!models/manifests/
!models/manifests/**
# Weight and checkpoint formats, wherever they appear.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.ot
*.msgpack
*.gguf
# Local environment variables and secrets. .env.example is the tracked template.
.env
.env.*
!.env.example
# NLTK data downloads (stored under models/nltk_data/; the name is also ignored here).
nltk_data/
