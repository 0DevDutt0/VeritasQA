# --- Local environment (not part of the project) ---
/VeritasQA/
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Tooling ---
.playwright-mcp/
.vscode/
.idea/

# --- Source documents and generated data (never committed) ---
# Source PDFs are never committed: the user's document may be confidential or copyrighted.
*.pdf
*.db
*.sqlite
*.sqlite3
data/documents/*
!data/documents/.gitkeep
data/extracted/*
!data/extracted/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/evaluations/runs/
# Gold answer files (questions, answers and quotations) stay local. The owner asked on 2026-11-05 that they not be
# pushed (decision D100). The placeholder file stays tracked.
data/evaluations/gold/*
!data/evaluations/gold/.gitkeep

# --- Model artifacts, weights, caches and local secrets ---
# V1 uses no model (D17). These rules are a guard: no weight or model cache is committed by accident.
# models/README.md is the only tracked file under models/.
models/**
!models/README.md
# Weight and checkpoint formats, wherever they appear.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.ot
*.msgpack
*.gguf
# Local environment variables and secrets. VeritasQA reads no .env file (D17).
.env
.env.*
# NLTK data is not used in V1 (Q6). The name stays ignored as a guard.
nltk_data/

# --- Personal notes (not part of the repository) ---
# The GitHub profile checklist is a personal file, not project documentation.
/github.md
