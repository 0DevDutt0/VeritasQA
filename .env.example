# Environment variables for VeritasQA. This file is a template.
#
# VeritasQA reads only the process environment (app/common/device.py) and never loads a .env
# file. Set variables in your shell, for example in PowerShell:
#   $env:VERITASQA_DEVICE = "cpu"
# Never commit real values or secrets.

# Device for the optional GPU components: auto (default), cuda, or cpu.
#   auto  uses CUDA when it is usable, otherwise the CPU.
#   cuda  fails with an actionable error when CUDA is not usable. It never falls back silently.
#   cpu   never uses the GPU.
VERITASQA_DEVICE=auto
